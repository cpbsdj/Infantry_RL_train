def links_lin_vel_z_l2(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")) -> torch.Tensor:
    """Penalize z-axis base linear velocity using L2 squared kernel."""
    # get the asset representing the humanoid
    asset: RigidObject | Articulation = env.scene[asset_cfg.name]
    # get the linear velocity of the links in the z-direction
    lin_vel_z = asset.data.body_lin_vel_w[:, asset_cfg.body_ids, 2]
    # calculate the reward
    reward = torch.sum(torch.square(lin_vel_z), dim=1)
    return reward

def links_ang_vel_xy_l2(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")) -> torch.Tensor:
    """Penalize xy-axis base angular velocity using L2 squared kernel."""
    # get the asset representing the humanoid
    asset: RigidObject | Articulation = env.scene[asset_cfg.name]
    # get the angular velocity of the links in the xy-plane
    ang_vel_xy = asset.data.body_ang_vel_w[:, asset_cfg.body_ids, :2]
    # calculate the reward
    reward = torch.sum(torch.square(ang_vel_xy), dim=(1, 2))
    return reward

def energy_cost(env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")) -> torch.Tensor:
    """Penalize the energy cost of the robot."""
    # get the asset representing the humanoid
    asset: Articulation = env.scene[asset_cfg.name]
    # get the joint torques
    joint_torques = asset.data.applied_torque[:, asset_cfg.joint_ids]
    # get the joint velocities
    joint_velocities = asset.data.joint_vel[:, asset_cfg.joint_ids]
    # calculate the reward
    reward = torch.sum(torch.square(joint_torques * joint_velocities), dim=1)
    return reward

def symmetric_legs(env: ManagerBasedRLEnv, left_asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"), right_asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")) -> torch.Tensor:
    """Penalize the asymmetry of the legs."""
    # get the asset representing the humanoid
    left_asset: Articulation = env.scene[left_asset_cfg.name]
    right_asset: Articulation = env.scene[right_asset_cfg.name]
    # get the joint positions of the legs
    left_joint_pos = left_asset.data.joint_pos[:, left_asset_cfg.joint_ids]
    right_joint_pos = right_asset.data.joint_pos[:, right_asset_cfg.joint_ids]
    # calculate the reward
    reward = torch.sum(torch.square(left_joint_pos + left_joint_pos), dim=1)
    return reward

def track_base_height_l2(
    env: ManagerBasedRLEnv,
    command_name: str,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
    sensor_cfg: SceneEntityCfg | None = None,
) -> torch.Tensor:
    """Penalize asset height from its target using L2 squared kernel.

    Note:
        For flat terrain, target height is in the world frame. For rough terrain,
        sensor readings can adjust the target height to account for the terrain.
    """
    # extract the used quantities (to enable type-hinting)
    asset: RigidObject = env.scene[asset_cfg.name]
    target_height = env.command_manager.get_command(command_name).squeeze(-1)
    if sensor_cfg is not None:
        sensor: RayCaster = env.scene[sensor_cfg.name]
        # Adjust the target height using the sensor data
        adjusted_target_height = target_height + torch.mean(sensor.data.ray_hits_w[..., 2], dim=1)
    else:
        # Use the provided target height directly for flat terrain
        adjusted_target_height = target_height
    # Compute the L2 squared penalty
    return torch.square(asset.data.root_pos_w[:, 2] - adjusted_target_height)

def track_base_height_exp(
    env: ManagerBasedRLEnv,
    std: float,
    command_name: str,
    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
    sensor_cfg: SceneEntityCfg | None = None,
) -> torch.Tensor:
    """Penalize asset height from its target using L2 squared kernel.

    Note:
        For flat terrain, target height is in the world frame. For rough terrain,
        sensor readings can adjust the target height to account for the terrain.
    """
    # extract the used quantities (to enable type-hinting)
    asset: RigidObject = env.scene[asset_cfg.name]
    target_height = env.command_manager.get_command(command_name).squeeze(-1)
    if sensor_cfg is not None:
        sensor: RayCaster = env.scene[sensor_cfg.name]
        # Adjust the target height using the sensor data
        adjusted_target_height = target_height + torch.mean(sensor.data.ray_hits_w[..., 2], dim=1)
    else:
        # Use the provided target height directly for flat terrain
        adjusted_target_height = target_height
    # Compute the L2 squared penalty
    return torch.exp(-torch.square(asset.data.root_pos_w[:, 2] - adjusted_target_height) / std**2)
